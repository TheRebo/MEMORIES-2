[node name="Bedroom" type="Node2D" unique_id=1960702284]
script = ExtResource("1_28d27")
room_id = "bedroom"
room_name = "Kamar Nenek"
short_name = "Kamar Nenek"
flashback = Array[Dictionary]([{
"focus": [120, 150],
"show": ["nenek", "mc_kecil"],
"speaker": "Nenek",
"text": "Uhuk uhuk...",
"tint": [1, 0.82, 0.55, 1]
}, {
"speaker": "Aku kecil",
"text": "Nenek? Nenek kenapa?"
}, {
"speaker": "Nenek",
"text": "Nenek baik-baik aja- uhuk uhuk!"
}, {
"speaker": "Aku kecil",
"text": "Nek..."
}, {
"speaker": "Nenek",
"text": "Udah udah, nenek gapapa."
}, {
"speaker": "Nenek",
"text": "Sini tiduran, udah malam loh."
}, {
"moves": [{
"actor": "mc_kecil",
"x": 112,
"y": 160
}],
"speaker": "Aku kecil",
"text": "Iya nek."
}, {
"speaker": "Aku kecil",
"text": "Kalau {mc} udah besar, nanti aku mau kerja."
}, {
"speaker": "Aku kecil",
"text": "Terus uangnya bisa beli obat biar nenek bisa sembuh."
}, {
"speaker": "Nenek",
"text": "(terkekeh) Iya iya, kalau udah kerja jangan lupa jenguk nenek ya."
}, {
"speaker": "Aku kecil",
"text": "Aku ga bakal lupa kok! Aku janji nek!"
}])

