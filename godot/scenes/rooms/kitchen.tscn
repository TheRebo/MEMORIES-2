}
tutorial = Array[Dictionary]([{
"text": "Ruangan jadi gelap, dan kamu hanya bisa membersihkan bagian yang terang. Tahan 5 (atau tahan slot Lilin), lalu lepas di lantai untuk memasang lilin. Kamu boleh memasang lebih dari satu. Lilin lama-lama habis, jadi pasang yang baru. Kalau terlalu lama gelap, sarang laba-laba makin banyak.",
"title": "Listrik Padam"
}])

