; Engine configuration file.
; MEMORIES: Godot 4.7 port of the web build (same data, same rules).

config_version=5

[application]

config/name="MEMORIES"
config/description="Pulang ke rumah Nenek, bersihkan ruangan demi ruangan."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/favicon.png"

[autoload]

Db="*res://autoload/db.gd"
GameState="*res://autoload/game_state.gd"
Settings="*res://autoload/settings.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://resources/theme/main_theme.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

